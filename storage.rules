rules_version = '2';

// ============================================================================
// QuizBaaz 3D — Cloud Storage rules
// ----------------------------------------------------------------------------
// Version: 2.0.0 (P0 security hardening — 2026-09-13)
//
// Admin content images (avatars, shop art) are uploaded by the client only
// when the caller holds the `admin` custom claim. No upload secret is held
// by the client — the old ImgBB API key has been removed from the source
// (see docs/SECURITY_P0_FIXES.md, R01).
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // 5 MB — enough for a content image, small enough to bound abuse.
    function isReasonableSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Public content served to players (avatars, shop art).
    // Read is public (display images); write is admin-only.
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isReasonableSize();
    }

    // A user's own folder (kept for a possible user-avatar flow).
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && isImage()
                   && isReasonableSize();
    }

    // Anything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
