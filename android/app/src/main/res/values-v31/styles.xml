<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows its own system splash screen (icon on a colored
         background) before the app draws. Without this override the system
         falls back to a white background, which looks broken for a dark app.
         Use the same navy as the adaptive icon background so the icon blends
         into the splash instead of sitting on a white page. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
